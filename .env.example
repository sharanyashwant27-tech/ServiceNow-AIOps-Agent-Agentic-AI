PORT=8910
SECRET_KEY=change-me-in-production

# Database: PostgreSQL in Docker, SQLite locally
DATABASE_URL=sqlite+aiosqlite:///./aiops.db
# DATABASE_URL=postgresql+asyncpg://aiops:aiops@localhost:5432/aiops

REDIS_URL=redis://localhost:6379/0
VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
# MILVUS_URI=http://localhost:19530
# PINECONE_API_KEY=
# PINECONE_INDEX=aiops-incidents

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
N8N_WEBHOOK_URL=

# LLM: local | openai | anthropic | ollama
LLM_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gpt-4o-mini

# Agent framework: langgraph | crewai | autogen
AGENT_FRAMEWORK=langgraph

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=aiops@example.com
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SMS_WEBHOOK_URL=
SMS_FROM=AIOPS

OCR_ENABLED=true
TESSERACT_CMD=
USE_INMEMORY_FALLBACK=true
ENABLE_METRICS=true
